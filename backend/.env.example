# Copy to .env in this folder (never commit .env)

# --- Code execution: Piston API (required for "Run code") ---
#
# Piston API URL:
# By default, it will use https://emkc.org/api/v2/piston (public API)
# Note: The public API may be whitelist-only. If so, provide a custom instance URL.
# PISTON_API_URL=https://emkc.org/api/v2/piston
#
# Optional: If your custom Piston instance requires an API key or auth token:
# PISTON_API_KEY=

# --- Optional: AI coding problems (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
